# Sepolia RPC used by wagmi and the relayer SDK.
NEXT_PUBLIC_SEPOLIA_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"

# WalletConnect project id. Get one at cloud.reown.com. Without it only
# injected wallets (MetaMask, Rabby) will connect.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""

# Pins a surface when there is no subdomain to read from the Host header,
# which is the case on *.vercel.app preview URLs. One of: web, app, docs.
NEXT_PUBLIC_SURFACE=""

# Deployed contract addresses. These are the live Sepolia shard, so they work
# as-is; ../deployments/sepolia.json is regenerated by scripts/deploy.ts if you
# deploy your own. Left unset, the footer renders "Not deployed" rather than a
# placeholder that resolves to nothing.
NEXT_PUBLIC_POOL_ADDRESS="0xe797Ce8f0F642045d93F329054BDF8895A6A505D"
NEXT_PUBLIC_DRAW_ADDRESS="0x4D319809028802278620E06e9FC46414ccAec57A"
NEXT_PUBLIC_CUSDT_ADDRESS="0xa31A85CD14cc1405870a5662d0EFfd11022D8BcE"
