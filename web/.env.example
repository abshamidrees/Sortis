# Sepolia RPC used by wagmi and the relayer SDK.
#
# The public node below works and is rate limited hard enough to be the first
# thing that breaks under real traffic. Every read in the app retries, which is
# what makes the free tier usable at all; a dedicated endpoint is the fix if
# the register or the draw history start rendering as unavailable.
NEXT_PUBLIC_SEPOLIA_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"

# Privy app id. Wallets connect through Privy, wallet only, with no email step.
# Without it the app renders and says it cannot connect.
#
# PRIVY_APP_SECRET is server side only and is deliberately absent from this
# file. It must never carry the NEXT_PUBLIC_ prefix, which would ship it to the
# browser.
NEXT_PUBLIC_PRIVY_APP_ID=""

# Pins a surface when there is no subdomain to read from the Host header,
# which is the case on *.vercel.app preview URLs. One of: web, app, docs.
NEXT_PUBLIC_SURFACE=""

# Deployed contract addresses, matching deployments/sepolia.json.
#
# KEEP THESE IN STEP WITH THAT FILE. This shipped a SortisDraw address from a
# replaced deployment for three days. That contract still exists on Sepolia, so
# a clone using it loaded, connected and displayed wrong state instead of
# failing visibly, which is the worst way for a stale address to be wrong.
NEXT_PUBLIC_POOL_ADDRESS="0xa57F6D5FC7780cbE5324EeC26d5a6BA88D22AeBa"
NEXT_PUBLIC_DRAW_ADDRESS="0x11625163932a8FD0cdB224B440c1C51C36Da0281"
NEXT_PUBLIC_CUSDT_ADDRESS="0x0ADfC89408f91aA3da2bac550Da87E1c6d08e989"
NEXT_PUBLIC_YIELD_ADDRESS="0xBeb04ad88B411661D15742dbE1a659a6CEbB96Ae"

# The earliest block worth scanning for this deployment's logs. Public RPCs
# reject an unbounded fromBlock: 0 range. Update it if you redeploy.
NEXT_PUBLIC_DEPLOY_BLOCK="11578000"
