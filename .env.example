# Deployment account. The default below is the standard Hardhat test mnemonic;
# replace it before touching Sepolia and never commit the replacement.
MNEMONIC="test test test test test test test test test test test junk"

# Sepolia RPC. Any provider works; a public node is fine for the mock suite.
SEPOLIA_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"

# Optional, for contract verification only.
ETHERSCAN_API_KEY=""

# Alternative to MNEMONIC: a single funded deployer key (0x-prefixed).
# Takes precedence over MNEMONIC when set. Never commit a real key.
PRIVATE_KEY=""
